# Runtime mode
APP_ENV=development
LOG_LEVEL=INFO

# Input and artifacts
INPUT_PDF_DIR=./sample_data
ARTIFACTS_DIR=./artifacts
VECTOR_DB_DIR=./vector_db

# Embeddings (placeholder values only)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=placeholder-embedding-model
EMBEDDING_DIMENSIONS=12
EMBEDDING_API_KEY=replace_me
EMBEDDING_API_BASE_URL=https://example.com/embeddings

# LLM (placeholder values only)
LLM_PROVIDER=stub
LLM_MODEL=placeholder-llm-model
LLM_API_KEY=replace_me
LLM_API_BASE_URL=https://example.com/llm

# Vector DB (placeholder values only)
VECTOR_DB_PROVIDER=local
VECTOR_DB_COLLECTION=valuation_chunks
VECTOR_DB_URL=http://localhost:6333
